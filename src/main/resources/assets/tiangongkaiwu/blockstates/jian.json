{
  "multipart": [
    {
      "apply": {
        "model": "tiangongkaiwu:block/jian_base"
      }
    },
    {
      "when": {
        "connect_north": false
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_wall"
      }
    },
    {
      "when": {
        "connect_east": false
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_wall",
        "y": 90
      }
    },
    {
      "when": {
        "connect_south": false
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_wall",
        "y": 180
      }
    },
    {
      "when": {
        "connect_west": false
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_wall",
        "y": 270
      }
    },
    {
      "when": {
        "connect_north": true
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_lip"
      }
    },
    {
      "when": {
        "connect_east": true
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_lip",
        "y": 90
      }
    },
    {
      "when": {
        "connect_south": true
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_lip",
        "y": 180
      }
    },
    {
      "when": {
        "connect_west": true
      },
      "apply": {
        "model": "tiangongkaiwu:block/jian_lip",
        "y": 270
      }
    }
  ]
}