{
  "id": "naili_shuji",
  "entry": "naili_juan/naili_shuji",
  "sentences": [
    {
      "wenyan": "凡黍与稷同类，粱与粟同类。",
      "tokens": [
        "黍和稷",
        "同类",
        "粱和粟",
        "也",
        "同类"
      ],
      "notes": ["黍：黏性小米类谷物，可酿酒；稷：不黏的黍类。粱为粟中良种，粟即小米。"]
    },
    {
      "wenyan": "凡粘黍、粘粟，统名曰秫。",
      "tokens": [
        "凡是",
        "黏的",
        "黍",
        "黏的",
        "粟",
        "都",
        "统称",
        "叫做",
        "秫"
      ],
      "notes": ["秫：黏性黍粟的总名，多用于酿酒。"]
    },
    {
      "wenyan": "扬花结穗，总与来、牟不相见也。",
      "tokens": [
        "开花",
        "结穗",
        "总是",
        "和",
        "小麦",
        "大麦",
        "不相见"
      ],
      "notes": ["扬花：禾谷抽穗开花；来＝小麦古称，牟＝大麦古称（见麦篇）——黍粟夏秋才秀穗，与冬麦不相逢。"]
    }
  ]
}
