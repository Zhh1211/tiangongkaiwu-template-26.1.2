  "sentences": [
    {
      "wenyan": "凡麦有数种，小麦曰来。",
      "tokens": [
        "麦子",
        "有",
        "好几种",
        "小麦",
        "叫做",
        "来"
      ],
      "notes": ["「来」为小麦古称，出《诗经》「贻我来牟」。"]
    },
    {
      "wenyan": "小麦曰来，麦之长也。",
      "tokens": [
        "小麦",
        "叫做",
        "来",
        "是",
        "麦中的",
        "长者"
      ],
      "notes": ["「来」为小麦古称；「长」音掌，谓居首位。"]
    },
    {
      "wenyan": "大麦曰牟、曰穬。",
      "tokens": [
        "大麦",
