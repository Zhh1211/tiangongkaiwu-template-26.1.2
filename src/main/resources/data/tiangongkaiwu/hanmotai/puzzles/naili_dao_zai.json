{
  "id": "naili_dao_zai",
  "entry": "naili_juan/naili_dao_zai",
  "sentences": [
    {
      "wenyan": "秧沉脚未定，阴雨连绵，则损折过半。",
      "tokens": [
        "秧苗",
        "还没",
        "扎稳根",
        "阴雨连绵",
        "就会",
        "损折过半"
      ],
      "notes": ["沉脚：秧根沉入泥中定根。谓插秧未定根即逢连阴雨，烂秧过半。"]
    },
    {
      "wenyan": "风灾不越三十里，阴雨灾不越三百里。",
      "tokens": [
        "风灾",
        "范围",
        "不超",
        "三十里",
        "阴雨灾",
        "不超",
        "三百里"
      ],
      "notes": ["越：超过。谓风、雨成灾皆有地域界限，非普天之祸。"]
    },
    {
      "wenyan": "将刈之时，少水一升，米粒缩小。",
      "tokens": [
        "临近收割",
        "之时",
        "少水一升",
        "米粒",
        "便会缩小"
      ],
      "notes": ["刈（音义）：收割。谓收前缺水，谷数不减而米粒干瘪，碾米多碎。"]
    }
  ]
