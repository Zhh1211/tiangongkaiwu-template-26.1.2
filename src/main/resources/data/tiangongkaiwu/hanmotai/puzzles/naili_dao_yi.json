{
  "id": "naili_dao_yi",
  "entry": "naili_juan/naili_dao_yi",
  "sentences": [
    {
      "wenyan": "凡稻土脉焦枯，则穗实萧索。",
      "tokens": [
        "稻田",
        "地力枯竭",
        "那么",
        "谷穗结实",
        "就稀疏"
      ],
      "notes": ["土脉：土壤的肥力脉络，即地力；萧索：稀少干瘪。"]
    },
    {
      "wenyan": "勤农粪田，多方以助之。",
      "tokens": [
        "勤快的",
        "农民",
        "给稻田施肥",
        "想尽",
        "办法",
        "帮助它"
      ],
      "notes": ["粪田：给田施粪肥。"]
    },
    {
      "wenyan": "土性带冷浆者，宜骨灰蘸秧根。",
      "tokens": [
        "带冷浆的",
        "田",
        "适宜",
        "用骨灰",
        "蘸",
        "秧根"
      ],
      "notes": ["冷浆：终年阴冷浸渍的水田；蘸秧根：插秧前把秧根在骨灰里裹一裹。"]
    }
  ]
}
