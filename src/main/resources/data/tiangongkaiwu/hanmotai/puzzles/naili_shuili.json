{
  "id": "naili_shuili",
  "entry": "naili_juan/naili_shuili",
  "sentences": [
    {
      "wenyan": "凡稻防旱借水，独甚五谷。",
      "tokens": [
        "水稻",
        "防旱",
        "全靠水",
        "比",
        "其它谷物",
        "更甚"
      ],
      "notes": ["借：凭借；独甚五谷：唯独比其他谷物更依赖水。"]
    },
    {
      "wenyan": "激轮使转，挽水入筒，昼夜不息。",
      "tokens": [
        "水流",
        "冲激",
        "轮子",
        "转动",
        "舀水",
        "进筒",
        "日夜不停"
      ],
      "notes": ["筒车：河滨水力提水轮，轮周缚竹筒，借水流自转，把水倾入水槽灌田。"]
    },
    {
      "wenyan": "用桔槔、辘轳，功劳又甚细已。",
      "tokens": [
        "至于",
        "用",
        "桔槔和辘轳",
        "汲水",
        "功效",
        "就很小了"
      ],
      "notes": ["桔槔（音洁高）：井边杠杆提水具；辘轳：井上绞盘；已：矣。谓此二具只宜浅井小汲。"]
    }
  ]
}
