{
  "id": "naili_ma",
  "entry": "naili_juan/naili_ma",
  "sentences": [
    {
      "wenyan": "凡麻可粒可油者，惟火麻、胡麻二种。",
      "tokens": [
        "能当粮",
        "又能榨油",
        "的麻类",
        "只有",
        "火麻",
        "胡麻",
        "两种"
      ],
      "notes": ["火麻：大麻，籽可食、可榨油；胡麻：即脂麻，今称芝麻。"]
    },
    {
      "wenyan": "胡麻即脂麻，相传西汉始自大宛来。",
      "tokens": [
        "胡麻",
        "就是",
        "脂麻",
        "相传",
        "西汉时",
        "从",
        "大宛",
        "传来"
      ],
      "notes": ["脂麻：即芝麻；大宛：西域古国，张骞通西域后传入中原。"]
    },
    {
      "wenyan": "古者以麻为五谷之一。",
      "tokens": [
        "古时候",
        "把",
        "麻",
        "当作",
        "五谷",
        "之一"
      ],
      "notes": ["五谷：麻、菽、麦、稷、黍——古五谷中有麻，位列总论辨名一节。"]
    }
  ]
}
