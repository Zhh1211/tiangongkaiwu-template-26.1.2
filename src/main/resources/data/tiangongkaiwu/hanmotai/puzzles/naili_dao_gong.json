{
  "id": "naili_dao_gong",
  "entry": "naili_juan/naili_dao_gong",
  "sentences": [
    {
      "wenyan": "凡稻田刈获不再种者，土宜本秋耕垦。",
      "tokens": [
        "凡是",
        "割完稻谷",
        "不再种",
        "的田",
        "应当",
        "当年秋天",
        "就翻耕"
      ],
      "notes": ["刈（音义）：收割；本秋：当年秋季。谓收后即耕，让稻茬腐烂成肥，抵得过施一次粪。"]
    },
    {
      "wenyan": "两人竟日，仅敌一牛之力。",
      "tokens": [
        "两个人",
        "干上一整天",
        "只抵得上",
        "一头牛",
        "的力气"
      ],
      "notes": ["竟日：整天；敌：匹敌。谓无牛之家以人代牛，两人一天仅顶一牛。"]
    },
    {
      "wenyan": "青叶既长，则耔可施焉。",
      "tokens": [
        "稻叶",
        "长齐",
        "之后",
        "就能",
        "耘田培土",
        "了"
      ],
      "notes": ["耔（音子）：俗称挞禾——手扶杖、用脚把泥壅到稻根上，顺势把田草压进泥里。"]
    }
  ]
}
